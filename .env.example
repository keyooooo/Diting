# 复制此文件为 .env 后填入真实值
# cp .env.example .env

# ============================================================
# 必需：LLM 模型（OpenAI 兼容 API）
# ============================================================
ARK_API_KEY=your-api-key-here #注意改成你选择的大模型所需要的名字（这里是火山的，所有是ARK_）
MODEL=your-model-id
BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ============================================================
# 必需：JWT 鉴权
# ============================================================
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=1440

# ============================================================
# 必需：基础设施
# 容器部署（docker compose up）用服务名：postgres / redis / standalone
# 本地开发用：localhost / 127.0.0.1
# ============================================================
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/langchain_app
REDIS_URL=redis://localhost:6379/0
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ============================================================
# 可选：嵌入模型
# ============================================================
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cpu
# DENSE_EMBEDDING_DIM=1024

# ============================================================
# 可选：ReRank 精排（不配置则跳过精排，保留 RRF 排序）
# ============================================================
# RERANK_MODEL=jina-reranker-v3
# RERANK_BINDING_HOST=https://api.jina.ai/v1/rerank
# RERANK_API_KEY=your-rerank-api-key

# ============================================================
# 可选：天气查询工具（不配置则工具调用时返回未配置提示）
# ============================================================
# AMAP_WEATHER_API=https://restapi.amap.com/v3/weather/weatherInfo
# AMAP_API_KEY=your-amap-api-key

# ============================================================
# 可选：检索调参
# ============================================================
# GRADE_MODEL=               # 评分模型，默认复用 MODEL
# AUTO_MERGE_ENABLED=true
# AUTO_MERGE_THRESHOLD=2
# LEAF_RETRIEVE_LEVEL=3

# ============================================================
# 可选：管理员注册
# ============================================================
# ADMIN_INVITE_CODE=my-secret-code

# ============================================================
# 可选：密码安全
# ============================================================
# PASSWORD_PBKDF2_ROUNDS=310000

# ============================================================
# 可选：LangSmith 调试追踪
# ============================================================
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-api-key
