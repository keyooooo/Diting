# 复制此文件为 .env 后填入真实值
# cp .env.example .env
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# ── LLM 模型 (ARK API) ──
ARK_API_KEY=your-api-key-here
MODEL=your-model-id
BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ── PostgreSQL (容器内用 postgres:5432, 本地用 localhost:5432) ──
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/langchain_app

# ── Redis (容器内用 redis:6379, 本地用 localhost:6379) ──
REDIS_URL=redis://redis:6379/0

# ── Milvus (容器内用 standalone:19530, 本地用 localhost:19530) ──
MILVUS_HOST=standalone
MILVUS_PORT=19530

# ── 可选 ──
# ADMIN_INVITE_CODE=my-secret-code
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cpu
# RERANK_MODEL=
# RERANK_BINDING_HOST=
# RERANK_API_KEY=
# AMAP_WEATHER_API=
# AMAP_API_KEY=
